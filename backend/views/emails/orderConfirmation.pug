extends base

block content
  h2 Confirmation de votre commande ##{order.orderNumber}
  
  p Bonjour #{user.firstName},
  
  p Nous avons bien reçu votre commande et nous vous remercions pour votre confiance.
  
  .order-summary(style="background-color: #f8f9fa; padding: 20px; border-radius: 4px; margin: 20px 0;")
    h3(style="margin-top: 0;") Récapitulatif de votre commande
    
    table(style="width: 100%; border-collapse: collapse;")
      thead
        tr
          th(style="text-align: left; padding: 8px 0; border-bottom: 1px solid #dee2e6;") Produit
          th(style="text-align: center; padding: 8px 0; border-bottom: 1px solid #dee2e6;") Qté
          th(style="text-align: right; padding: 8px 0; border-bottom: 1px solid #dee2e6;") Prix
      tbody
        each item in order.items
          tr
            td(style="padding: 12px 0; border-bottom: 1px solid #f0f0f0;")
              strong= item.product.name
              if item.product.brand
                br
                span.text-muted= item.product.brand.name
            td(style="text-align: center; padding: 12px 0; border-bottom: 1px solid #f0f0f0;")= item.quantity
            td(style="text-align: right; padding: 12px 0; border-bottom: 1px solid #f0f0f0;")= (item.unitPrice * item.quantity).toFixed(2) + ' €'
      tfoot
        tr
          td(colspan="2" style="text-align: right; padding: 12px 0; font-weight: bold;") Total TTC
          td(style="text-align: right; padding: 12px 0; font-weight: bold; font-size: 18px;")= order.totalAmount.toFixed(2) + ' €'
  
  .delivery-info(style="margin: 30px 0;")
    h3 Informations de livraison
    p
      strong Mode de livraison :
      |  #{order.deliveryOption.name}
      br
      strong Adresse de livraison :
      br
      | #{order.deliveryAddress.street}
      br
      | #{order.deliveryAddress.postalCode} #{order.deliveryAddress.city}
      br
      | #{order.deliveryAddress.country}
    
    if order.estimatedDeliveryDate
      p
        strong Date de livraison estimée :
        |  #{new Date(order.estimatedDeliveryDate).toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
  
  .text-center
    a.button(href=`${appUrl}/account/orders/${order.id}`) Suivre ma commande
  
  p.mt-3
    strong Une question sur votre commande ?
    br
    | Contactez notre service client :
    br
    | Email : 
    a(href="mailto:contact.kitchenly@gmail.com") contact.kitchenly@gmail.com