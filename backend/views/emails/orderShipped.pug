extends base

block content
  h2 Votre commande est en route ! 📦
  
  p Bonjour #{user.firstName},
  
  p Bonne nouvelle ! Votre commande ##{order.orderNumber} vient d'être expédiée.
  
  .shipping-info(style="background-color: #d4edda; border: 1px solid #c3e6cb; padding: 20px; border-radius: 4px; margin: 20px 0;")
    h3(style="margin-top: 0;") Informations de livraison
    p
      strong Transporteur :
      |  #{carrier || 'La Poste'}
      br
      strong Numéro de suivi :
      |  #{trackingNumber}
      br
      strong Date d'expédition :
      |  #{new Date().toLocaleDateString('fr-FR')}
      br
      strong Livraison prévue :
      |  #{estimatedDelivery || 'Sous 2 à 4 jours ouvrés'}
  
  .text-center
    a.button(href=trackingUrl || `${appUrl}/track/${trackingNumber}`) Suivre mon colis
  
  p
    strong Produits expédiés :
  ul
    each item in order.items
      li
        | #{item.quantity}x #{item.product.name}
        if item.product.brand
          |  - #{item.product.brand.name}
  
  p
    strong 📍 Adresse de livraison :
    br
    | #{order.deliveryAddress.firstName} #{order.deliveryAddress.lastName}
    br
    | #{order.deliveryAddress.street}
    br
    | #{order.deliveryAddress.postalCode} #{order.deliveryAddress.city}
    br
    | #{order.deliveryAddress.country}
  
  if order.deliveryOption.type === 'relay_point'
    p
      strong Point relais :
      br
      | #{order.deliveryOption.relayPoint.name}
      br
      | #{order.deliveryOption.relayPoint.address}
  
  .tips(style="background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 4px; margin: 20px 0;")
    h4(style="margin-top: 0;") 💡 Conseils de réception
    ul(style="margin-bottom: 0;")
      li Vérifiez l'état du colis avant de signer
      li En cas de dommage apparent, refusez le colis
      li Conservez l'emballage en cas de retour
  
  p.mt-3
    strong Besoin d'aide ?
    br
    | Service livraison : 
    a(href="mailto:contact.kitchenly@gmail.com") contact.kitchenly@gmail.com
    br
    | Téléphone : 01 23 45 67 87