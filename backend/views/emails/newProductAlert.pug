extends base

block content
  h2 Nouveaux produits dans votre catégorie préférée
  
  p Bonjour #{user.firstName},
  
  p De nouveaux produits viennent d'arriver dans la catégorie "#{category.name}" que vous suivez !
  
  each product in products
    .product-card(style="background-color: #f8f9fa; padding: 20px; border-radius: 4px; margin: 20px 0;")
      h3(style="margin-top: 0;")= product.name
      if product.brand
        p(style="color: #6c757d;")= product.brand.name
      
      if product.description
        p= product.description.substring(0, 150) + '...'
      
      p(style="font-size: 18px; font-weight: bold; color: #007bff;")
        | #{product.price.toFixed(2)} €
      
      .text-center
        a.button(href=`${appUrl}/products/${product.slug}` style="display: inline-block; margin: 10px 0;") Découvrir
  
  .text-center(style="margin: 30px 0;")
    a.button(href=`${appUrl}/products?category=${category.slug}`) Voir tous les produits #{category.name}
  
  p.text-muted(style="margin-top: 30px; font-size: 14px;")
    | Vous recevez cette alerte car vous suivez la catégorie "#{category.name}".
    br
    a(href=`${appUrl}/account/alerts` style="color: #6c757d;") Gérer mes alertes