doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= subject
    style
      include ./styles.css
  body
    .email-container
      .header
        h1.logo Kitchenly
        p.tagline L'excellence pour votre cuisine
      
      .content
        h2 Attention #{firstName} !
        
        .alert-box.warning
          p ⚠️ Le stock du produit que vous surveillez est faible
        
        .product-card
          if product.images && product.images.length > 0
            img.product-image(src=product.images[0], alt=product.name)
          h3= product.name
          .stock-warning
            p.current-stock Plus que #{currentStock} unités en stock !
            p.threshold (Seuil d'alerte : #{threshold} unités)
          p.price #{product.price.toFixed(2)} €
          
          a.cta-button.urgent(href=productUrl) Commander maintenant
        
        .info-box
          p 🔥 Ce produit part vite ! Commandez dès maintenant pour ne pas le manquer.
        
        p.footer-text
          | Vous recevez cet email car vous avez activé une alerte de stock faible pour ce produit. 
          a(href=`${appUrl}/account/alerts`) Gérer mes alertes
        
      .footer
        p © 2025 Kitchenly. Tous droits réservés.
        p.small
          a(href=`${appUrl}/privacy`) Politique de confidentialité
          |  | 
          a(href=`${appUrl}/terms`) Conditions d'utilisation

style.
  .alert-box.warning {
    background-color: #fff3cd;
    color: #856404;
    border: 1px solid #ffeaa7;
  }
  
  .stock-warning {
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 5px;
    padding: 15px;
    margin: 15px 0;
  }
  
  .current-stock {
    color: #721c24;
    font-size: 18px;
    font-weight: bold;
    margin: 5px 0;
  }
  
  .threshold {
    color: #856404;
    font-size: 14px;
    margin: 5px 0;
  }
  
  .cta-button.urgent {
    background-color: #dc3545;
  }
  
  .cta-button.urgent:hover {
    background-color: #c82333;
  }