extends base

block content
  h2 Confirmation d'annulation de commande
  
  p Bonjour #{user.firstName},
  
  p Nous vous confirmons l'annulation de votre commande ##{order.orderNumber}.
  
  .cancellation-info(style="background-color: #f8f9fa; padding: 20px; border-radius: 4px; margin: 20px 0;")
    h3(style="margin-top: 0;") Détails de l'annulation
    p
      strong Numéro de commande :
      |  #{order.orderNumber}
      br
      strong Date de commande :
      |  #{new Date(order.createdAt).toLocaleDateString('fr-FR')}
      br
      strong Date d'annulation :
      |  #{new Date().toLocaleDateString('fr-FR')}
      br
      strong Montant :
      |  #{order.totalAmount.toFixed(2)} €
      if cancellationReason
        br
        strong Motif :
        |  #{cancellationReason}
  
  if order.paymentStatus === 'paid'
    .refund-info(style="background-color: #d4edda; border: 1px solid #c3e6cb; padding: 15px; border-radius: 4px; margin: 20px 0;")
      p(style="margin: 0;")
        strong 💰 Remboursement en cours
        br
        | Votre remboursement sera effectué sur le même moyen de paiement utilisé lors de la commande.
        br
        | Délai de remboursement : 5 à 10 jours ouvrés selon votre banque.
  
  p Les produits suivants ont été annulés :
  ul
    each item in order.items
      li
        | #{item.quantity}x #{item.product.name}
        if item.product.brand
          |  - #{item.product.brand.name}
  
  p.mt-3
    | Nous espérons vous revoir bientôt sur Kitchenly. N'hésitez pas à nous faire part de vos commentaires pour nous aider à améliorer notre service.
  
  .text-center
    a.button(href=`${appUrl}/products`) Continuer mes achats
  
  p.mt-3
    strong Une question sur votre annulation ?
    br
    | Contactez notre service client :
    br
    | Email : 
    a(href="mailto:contact.kitchenly@gmail.com") contact.kitchenly@gmail.com
    br
    | Téléphone : 01 23 45 67 89