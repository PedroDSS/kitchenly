extends base

block content
  h2 Bonjour #{firstName},
  p Voici un résumé de vos alertes Kitchenly :
  
  each alertGroup in alerts
    .alert-section(style="background-color: #f8f9fa; padding: 15px; border-radius: 4px; margin: 20px 0;")
      if alertGroup.alert.type === 'price_drop'
        h3 📉 Baisses de prix
        each change in alertGroup.changes
          .alert-item(style="margin: 10px 0; padding: 10px; border-bottom: 1px solid #e9ecef;")
            h4(style="margin: 5px 0;")= change.product.name
            p(style="margin: 5px 0;")
              span(style="text-decoration: line-through; color: #6c757d;") #{change.oldPrice.toFixed(2)} €
              |  → 
              span(style="color: #28a745; font-weight: bold;") #{change.newPrice.toFixed(2)} €
              |  
              span(style="color: #28a745;") (-#{Math.round((1 - change.newPrice / change.oldPrice) * 100)}%)
            a(href=`${appUrl}/products/${change.product.slug}` style="color: #007bff;") Voir le produit
      
      else if alertGroup.alert.type === 'back_in_stock'
        h3 ✅ Retour en stock
        each change in alertGroup.changes
          .alert-item(style="margin: 10px 0; padding: 10px; border-bottom: 1px solid #e9ecef;")
            h4(style="margin: 5px 0;")= change.product.name
            p(style="margin: 5px 0;") #{change.product.stock} unités disponibles
            a(href=`${appUrl}/products/${change.product.slug}` style="color: #007bff;") Voir le produit
      
      else if alertGroup.alert.type === 'new_product'
        h3 🆕 Nouveaux produits dans #{alertGroup.alert.category.name}
        each product in alertGroup.changes
          .alert-item(style="margin: 10px 0; padding: 10px; border-bottom: 1px solid #e9ecef;")
            h4(style="margin: 5px 0;")= product.name
            p(style="margin: 5px 0; font-weight: bold;") #{product.price.toFixed(2)} €
            a(href=`${appUrl}/products/${product.slug}` style="color: #007bff;") Découvrir
  
  .text-center(style="margin: 30px 0;")
    a.button(href=appUrl) Visiter la boutique
    p(style="margin-top: 20px;")
      a(href=manageAlertsUrl style="color: #6c757d;") Gérer mes alertes
  
  p.text-muted(style="margin-top: 30px; font-size: 14px;")
    | Vous recevez ce résumé car vous avez configuré des alertes sur Kitchenly.
    br
    a(href=manageAlertsUrl style="color: #6c757d;") Se désabonner