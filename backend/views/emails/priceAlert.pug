extends base

block content
  h2 Alerte prix : #{product.name}
  
  p Bonjour #{user.firstName},
  
  p Bonne nouvelle ! Le prix d'un produit que vous suivez vient de baisser.
  
  .price-drop(style="background-color: #d4edda; border: 1px solid #c3e6cb; padding: 20px; border-radius: 4px; margin: 20px 0; text-align: center;")
    h3(style="margin-top: 0;")= product.name
    if product.brand
      p(style="color: #6c757d;")= product.brand.name
    
    p(style="font-size: 24px; margin: 20px 0;")
      span(style="text-decoration: line-through; color: #6c757d;") #{oldPrice.toFixed(2)} €
      |  → 
      span(style="color: #28a745; font-weight: bold;") #{newPrice.toFixed(2)} €
    
    p(style="color: #28a745; font-size: 18px;")
      | Économisez #{(oldPrice - newPrice).toFixed(2)} € (-#{Math.round((1 - newPrice / oldPrice) * 100)}%)
  
  .text-center
    a.button(href=`${appUrl}/products/${product.slug}`) Voir le produit
  
  p.mt-3
    | ⏰ Cette offre peut être limitée dans le temps. Ne tardez pas !
  
  p.text-muted(style="margin-top: 30px; font-size: 14px;")
    | Vous recevez cette alerte car vous suivez ce produit.
    br
    a(href=`${appUrl}/account/alerts` style="color: #6c757d;") Gérer mes alertes