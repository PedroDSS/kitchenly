doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= subject
    style
      include ./styles.css
  body
    .email-container
      .header
        h1.logo Kitchenly
        p.tagline L'excellence pour votre cuisine
      
      .content
        h2 Excellente nouvelle #{firstName} !
        
        .alert-box.discount
          p Le prix du produit que vous surveillez a baissé !
          .discount-badge -#{discount}%
        
        .product-card
          if product.images && product.images.length > 0
            img.product-image(src=product.images[0], alt=product.name)
          h3= product.name
          
          .price-comparison
            p.old-price
              span.label Ancien prix : 
              span.value #{oldPrice.toFixed(2)} €
            p.new-price
              span.label Nouveau prix : 
              span.value #{newPrice.toFixed(2)} €
            p.savings
              span.label Vous économisez : 
              span.value #{(oldPrice - newPrice).toFixed(2)} €
          
          a.cta-button(href=`${appUrl}/products/${product.slug}`) Profiter de l'offre
        
        .info-box
          p 💡 Cette offre est limitée dans le temps. Profitez-en maintenant !
        
        p.footer-text
          | Vous recevez cet email car vous avez activé une alerte de prix pour ce produit. 
          a(href=`${appUrl}/account/alerts`) Gérer mes alertes
        
      .footer
        p © 2025 Kitchenly. Tous droits réservés.
        p.small
          a(href=`${appUrl}/privacy`) Politique de confidentialité
          |  | 
          a(href=`${appUrl}/terms`) Conditions d'utilisation