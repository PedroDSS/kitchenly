extends base

block content
  h2 Retour en stock : #{product.name}
  
  p Bonjour #{user.firstName},
  
  p Excellente nouvelle ! Le produit que vous attendez est de nouveau disponible.
  
  .back-in-stock(style="background-color: #d4edda; border: 1px solid #c3e6cb; padding: 20px; border-radius: 4px; margin: 20px 0; text-align: center;")
    h3(style="margin-top: 0;")= product.name
    if product.brand
      p(style="color: #6c757d;")= product.brand.name
    
    p(style="font-size: 20px; color: #28a745; margin: 20px 0;")
      | ✅ Disponible maintenant
    
    p
      strong Stock actuel : 
      | #{product.stock} unités
    
    p(style="font-size: 18px;")
      strong Prix : 
      | #{product.price.toFixed(2)} €
  
  .text-center
    a.button(href=`${appUrl}/products/${product.slug}`) Commander maintenant
  
  p.mt-3
    | ⚡ Les stocks sont limités. Commandez rapidement pour ne pas manquer cette opportunité !
  
  p.text-muted(style="margin-top: 30px; font-size: 14px;")
    | Vous recevez cette alerte car vous avez demandé à être notifié du retour en stock de ce produit.
    br
    a(href=`${appUrl}/account/alerts` style="color: #6c757d;") Gérer mes alertes