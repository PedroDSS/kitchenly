doctype html
html(lang="fr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= subject
    style
      include ./styles.css
  body
    .email-container
      .header
        h1.logo Kitchenly
        p.tagline L'excellence pour votre cuisine
      
      .content
        h2 Bonne nouvelle #{firstName} !
        
        .alert-box.success
          p Le produit que vous surveillez est de nouveau disponible !
        
        .product-card
          if product.images && product.images.length > 0
            img.product-image(src=product.images[0], alt=product.name)
          h3= product.name
          p.price #{product.price.toFixed(2)} €
          p.stock-info #{product.stock} unités en stock
          
          a.cta-button(href=`${appUrl}/products/${product.slug}`) Voir le produit
        
        .info-box
          p.urgent ⚡ Attention : Ce produit est très demandé. N'attendez pas pour passer commande !
        
        p.footer-text
          | Vous recevez cet email car vous avez activé une alerte de stock pour ce produit. 
          a(href=`${appUrl}/account/alerts`) Gérer mes alertes
        
      .footer
        p © 2025 Kitchenly. Tous droits réservés.
        p.small
          a(href=`${appUrl}/privacy`) Politique de confidentialité
          |  | 
          a(href=`${appUrl}/terms`) Conditions d'utilisation