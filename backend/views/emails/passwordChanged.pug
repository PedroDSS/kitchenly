extends base

block content
  h2 Votre mot de passe a été modifié
  
  p Bonjour #{user.firstName},
  
  p Nous vous confirmons que votre mot de passe a été modifié avec succès.
  
  .alert(style="background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 4px; margin: 20px 0;")
    p(style="margin: 0;")
      strong ⚠️ Si vous n'êtes pas à l'origine de cette modification :
      br
      | Veuillez immédiatement :
      br
      | 1. Réinitialiser votre mot de passe
      br
      | 2. Contacter notre équipe de sécurité
  
  p
    strong Informations de sécurité :
    br
    | Date de modification : #{new Date().toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
    br
    | Adresse IP : #{ipAddress || 'Non disponible'}
    br
    | Navigateur : #{userAgent || 'Non disponible'}
  
  p.mt-3 Pour votre sécurité, nous vous recommandons de :
  ul
    li Utiliser un mot de passe unique pour Kitchenly
    li Activer l'authentification à deux facteurs
    li Ne jamais partager votre mot de passe
  
  .text-center
    a.button(href=`${appUrl}/account/security`) Gérer ma sécurité
  
  p.mt-3
    strong Un problème ?
    br
    | Contactez immédiatement notre équipe sécurité :
    br
    | Email : 
    a(href="mailto:contact.kitchenly@gmail.com") contact.kitchenly@gmail.com